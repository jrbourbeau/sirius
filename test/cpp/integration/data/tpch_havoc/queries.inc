HAVOC_QUERY("Q17_V07", "FILTER clause (OLAP): Use FILTER for conditional aggregation", R"havoc(select sum(l_extendedprice) filter (where l_quantity < (select 0.2 * avg(l_quantity) from lineitem where l_partkey = p_partkey)) / 7.0 as avg_yearly from lineitem, part where p_partkey = l_partkey and p_brand = 'Brand#23' and p_container = 'MED BOX'
