        when l_returnflag = 'R' then 'R'
        else l_returnflag
    end as l_returnflag,
    case
        when l_linestatus = 'F' then 'F'
        when l_linestatus = 'O' then 'O'
        else l_linestatus
    end as l_linestatus,
