HAVOC_QUERY("Q17_V06", "Derived table: Use derived tables for subqueries", R"havoc(select sum(lineitem_data.l_extendedprice) / 7.0 as avg_yearly from (select l.l_extendedprice, l.l_quantity, l.l_partkey from lineitem l, part p, (select l_partkey as pk, 0.2 * avg(l_quantity) as threshold from lineitem group by l_partkey) avg_data where p.p_partkey = l.l_partkey and p.p_brand = 'Brand#23' and p.p_container = 'MED BOX' and avg_data.pk = l.l_partkey and l.l_quantity < avg_data.threshold) lineitem_data
