HAVOC_QUERY("Q18_V03", "Explicit JOINs: Replace comma-separated tables with explicit JOINs", R"havoc(select c.c_name, c.c_custkey, o.o_orderkey, o.o_orderdate, o.o_totalprice, sum(l.l_quantity) from customer c inner join orders o on c.c_custkey = o.o_custkey inner join lineitem l on o.o_orderkey = l.l_orderkey inner join (select l_orderkey from lineitem group by l_orderkey having sum(l_quantity) > 300) large_orders on o.o_orderkey = large_orders.l_orderkey group by c.c_name, c.c_custkey, o.o_orderkey, o.o_orderdate, o.o_totalprice order by o.o_totalprice desc, o.o_orderdate limit 100
