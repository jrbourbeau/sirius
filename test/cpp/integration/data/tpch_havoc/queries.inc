HAVOC_QUERY("Q17_V09", "Window functions (OLAP): Use window functions for ranking", R"havoc(with lineitem_with_avg as (select l_extendedprice, l_quantity, l_partkey, 0.2 * avg(l_quantity) over (partition by l_partkey) as avg_threshold from lineitem) select sum(lwa.l_extendedprice) / 7.0 as avg_yearly from lineitem_with_avg lwa, part p where p.p_partkey = lwa.l_partkey and p.p_brand = 'Brand#23' and p.p_container = 'MED BOX' and lwa.l_quantity < lwa.avg_threshold
