HAVOC_QUERY("Q17_V03", "Explicit JOINs: Replace comma-separated tables with explicit JOINs", R"havoc(select sum(l_extendedprice) / 7.0 as avg_yearly from lineitem l inner join part p on p.p_partkey = l.l_partkey inner join (select l_partkey, 0.2 * avg(l_quantity) as threshold from lineitem group by l_partkey) avg_calc on l.l_partkey = avg_calc.l_partkey where p.p_brand = 'Brand#23' and p.p_container = 'MED BOX' and l.l_quantity < avg_calc.threshold
