HAVOC_QUERY("Q18_V04", "UNION ALL: Split query by conditions", R"havoc(select c_name, c_custkey, o_orderkey, o_orderdate, o_totalprice, total_qty from (select c.c_name, c.c_custkey, o.o_orderkey, o.o_orderdate, o.o_totalprice, sum(l.l_quantity) as total_qty from customer c, orders o, lineitem l where c.c_custkey = o.o_custkey and o.o_orderkey = l.l_orderkey group by c.c_name, c.c_custkey, o.o_orderkey, o.o_orderdate, o.o_totalprice union all select 'DUMMY' as c_name, -1 as c_custkey, -1 as o_orderkey, date '1900-01-01' as o_orderdate, 0 as o_totalprice, 0 as total_qty where false) combined where total_qty > 300 order by o_totalprice desc, o_orderdate limit 100
