HAVOC_QUERY("Q18_V08", "EXISTS pattern: Use EXISTS for membership testing", R"havoc(select c_name, c_custkey, o_orderkey, o_orderdate, o_totalprice, sum(l_quantity) from customer, orders, lineitem where exists (select 1 from (select l_orderkey from lineitem group by l_orderkey having sum(l_quantity) > 300) large_orders where large_orders.l_orderkey = o_orderkey) and c_custkey = o_custkey and o_orderkey = l_orderkey group by c_name, c_custkey, o_orderkey, o_orderdate, o_totalprice order by o_totalprice desc, o_orderdate limit 100
